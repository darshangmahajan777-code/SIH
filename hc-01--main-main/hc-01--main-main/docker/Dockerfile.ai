FROM python:3.11-slim
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8001

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD python -c "import os, urllib.request; port = os.getenv('AI_PORT', os.getenv('PORT', '8001')); urllib.request.urlopen(f'http://localhost:{port}/health')" || exit 1

CMD ["python", "main.py"]
