# ==============================================================================
# MediQueue+ Production Environment Variables Template (.env.example)
# ==============================================================================
# Copy this template to .env and configure for your target deployment environment.
# DO NOT commit real secrets, API keys, tokens, or passwords to version control.
# ==============================================================================

# ==============================================================================
# 1. CLIENT (Used by /client - Vite React Frontend)
# ==============================================================================
# Public REST API base URL (e.g. https://api.mediqueue.example.com)
# When empty, client defaults to relative /api routing via Nginx or Vite proxy
VITE_API_URL=

# Public WebSocket / Socket.IO URL (e.g. https://api.mediqueue.example.com)
# When empty, client defaults to current host origin
VITE_SOCKET_URL=

# Fallback backend URL for local Vite dev proxy and decoupled cross-origin clients
VITE_BACKEND_URL=


# ==============================================================================
# 2. SERVER (Used by /server - Node.js Express Application)
# ==============================================================================
# Node execution environment ("production", "development", or "test")
NODE_ENV=

# Network port for HTTP and Socket.IO server (e.g. 5000)
PORT=

# Allowed origins for HTTP API requests and WebSocket handshakes
# Supports comma-separated origins and wildcards (e.g. https://mediqueue.org,*.vercel.app)
CORS_ORIGIN=

# API rate limiting window duration in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=

# Maximum allowed requests per IP within the rate limiting window (default: 200)
RATE_LIMIT_MAX_REQUESTS=


# ==============================================================================
# 3. DATABASE (Used by /server - MongoDB Persistence & Scalability)
# ==============================================================================
# MongoDB connection URI (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/mediqueue)
MONGO_URI=

# Optional Redis connection URI for multi-instance horizontal Socket.IO scaling
REDIS_URL=


# ==============================================================================
# 4. AUTH (Used by /server - Authentication & Security Tokens)
# ==============================================================================
# High-entropy secret key for cryptographic JWT signing and telemedicine sessions
JWT_SECRET=

# JWT token expiration period (e.g. 7d, 24h, 3600s)
JWT_EXPIRY=

# Administrative API authorization key for cross-hospital management via x-admin-key header
ADMIN_API_KEY=


# ==============================================================================
# 5. AI (Used by /server and /ai - FastAPI Microservice & Decision Support)
# ==============================================================================
# HTTP endpoint URL of the Python AI service as reached by the backend (e.g. http://ai:8001)
AI_URL=

# Host IP binding for the Python FastAPI Uvicorn server (default: 0.0.0.0)
AI_HOST=

# Network port for the Python FastAPI Uvicorn service (default: 8001)
AI_PORT=

# Maximum patient queue starvation bypass limit in minutes before priority insertion
STARVATION_LIMIT=


# ==============================================================================
# 6. SOCKET (Used by /server and /client - Real-Time Communication)
# ==============================================================================
# Socket.IO connection ping timeout in milliseconds (default: 60000)
SOCKET_PING_TIMEOUT=

# Socket.IO connection ping interval in milliseconds (default: 25000)
SOCKET_PING_INTERVAL=

# Supported socket connection transports (default: websocket,polling)
SOCKET_TRANSPORTS=


# ==============================================================================
# 7. STORAGE (Used by /server - Medical Documents, Lab Reports, Prescriptions)
# ==============================================================================
# Local directory path for stored medical reports and attachments (e.g. ./uploads)
FILE_UPLOAD_DIR=

# Maximum allowed file upload size in bytes (default: 10485760 = 10MB)
MAX_UPLOAD_SIZE_BYTES=

# Document storage driver provider: "local" or "s3_compatible"
STORAGE_PROVIDER=

# S3/Cloud storage bucket name (applicable when STORAGE_PROVIDER=s3_compatible)
S3_BUCKET=

# S3/Cloud storage region
S3_REGION=


# ==============================================================================
# 8. NOTIFICATIONS (Used by /server - Alert Dispatcher & Reminders)
# ==============================================================================
# Number of patients ahead in queue that triggers the automated Near-Turn alert (default: 5)
NEAR_TURN_THRESHOLD=

# Enable automated SMS alerts for queue status and appointment reminders ("true" or "false")
ENABLE_SMS_NOTIFICATIONS=

# Enable automated email reminders for appointments and care plans ("true" or "false")
ENABLE_EMAIL_NOTIFICATIONS=

# Cron schedule expression for reminder scheduler evaluation (default: */1 * * * *)
NOTIFICATION_CRON_INTERVAL=


# ==============================================================================
# 9. VIDEO (Used by /client and /server - Telemedicine WebRTC Infrastructure)
# ==============================================================================
# Public STUN server URL for WebRTC peer NAT traversal (e.g. stun:stun.l.google.com:19302)
STUN_SERVER_URL=

# Optional TURN relay server URL for symmetric NAT / firewall traversal
TURN_SERVER_URL=

# TURN server authentication username
TURN_SERVER_USERNAME=

# TURN server authentication credential / shared secret
TURN_SERVER_CREDENTIAL=


# ==============================================================================
# 10. EXTERNAL SERVICES (Used by /server - Third-Party Integrations)
# ==============================================================================
# External SMS gateway dispatch endpoint
SMS_GATEWAY_URL=

# Authorization key for external SMS provider
SMS_API_KEY=

# External SMTP mail server host
SMTP_HOST=

# External SMTP mail server port (e.g. 587, 465)
SMTP_PORT=

# External SMTP authentication username
SMTP_USER=

# External SMTP authentication password
SMTP_PASS=
