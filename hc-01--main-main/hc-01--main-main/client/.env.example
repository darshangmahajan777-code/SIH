# ==============================================================================
# MediQueue+ Client Environment Configuration Template
# ==============================================================================
# Copy this template to client/.env for production builds.
# In local development, leave these blank to utilize Vite dev server proxying.
# ==============================================================================

# Production Backend REST API Base URL
# Both VITE_API_BASE_URL and VITE_API_URL are supported by the application.
# Example: https://hospital-queue-server.onrender.com
VITE_API_BASE_URL=
VITE_API_URL=

# Production Socket.IO Server WebSocket/Polling URL
# Example: https://hospital-queue-server.onrender.com
VITE_SOCKET_URL=

# Fallback Backend URL for local Vite dev server proxy
VITE_BACKEND_URL=
