# ==============================================================================
# MediQueue+ Backend Server Environment Configuration
# ==============================================================================
# Copy this file to server/.env. Never commit production credentials.
# ==============================================================================

# Operating mode ("development" | "production" | "test")
NODE_ENV=

# Port for Express and Socket.IO server (default: 5000)
PORT=

# MongoDB connection string
# Development default: mongodb://localhost:27017/hospital-queue
MONGO_URI=

# Cryptographic secret for signing JWTs and HMAC telemedicine session tokens
# Must be set to a strong random value in production
JWT_SECRET=

# Allowed CORS origins (comma-separated if multiple allowed origins)
# Example: http://localhost:5173,http://localhost:3000
CORS_ORIGIN=

# URL of the Python AI microservice
# Default local: http://localhost:8001
AI_URL=
